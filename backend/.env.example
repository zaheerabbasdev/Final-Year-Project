PORT=5000
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=kaarkun_db

# Generate strong random secrets, e.g.: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d

# Comma-separated list of allowed frontend origins (admin panel, web app)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Required to create the first/any admin account via POST /api/admin/auth/register
ADMIN_SETUP_KEY=

# Email (Nodemailer) — use an app password, never your real account password
EMAIL_USER=
EMAIL_PASS=

# AI API Keys
# ► Groq (FREE) — Get key at: https://console.groq.com/keys
GROQ_API_KEY=

# ► Google Gemini (FREE) — Get key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ► Anthropic Claude (PAID) — Get key at: https://console.anthropic.com/settings/api-keys
CLAUDE_API_KEY=
